{
  "name": "quote-buddy",
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "sync": "npx cap sync",
    "generate-icons": "node generate-icons.js",
    "clear-cache": "node -e \"console.log('Use window.clearCache() in browser console or hard refresh (Ctrl+Shift+R)')\"",
    "version": "node -e \"console.log(require('./package.json').version)\"",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^6.0.1",
    "@capacitor-community/speech-recognition": "^6.0.1",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/share": "^6.0.4",
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.10.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.2.8",
    "@google/generative-ai": "^0.24.1",
    "@ionic/react": "^7.8.0",
    "@ionic/react-router": "^7.8.0",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.5.1",
    "ai-token-monitor": "^1.0.9",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "ionicons": "^7.2.2",
    "jspdf": "^2.5.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "openai": "^6.42.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.6.0",
    "react-pdf": "^7.7.1",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/sharp": "^0.31.1",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^10.0.7",
    "prisma": "^6.19.3",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^4.1.11"
  }
}
