VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_MAX_FILE_SIZE_MB=10

# MilesWeb MySQL (Prisma)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
AUTH_SECRET=change-me
AUTH_SESSION_SECRET=change-me
API_PORT=8787
# Local disk fallback only when MilesWeb upload bridge is unset
# UPLOAD_ROOT=/home/USER/public_html/uploads

# Shared Cost Manager MilesWeb public storage
NEXT_PUBLIC_UPLOADS_BASE_URL=https://wellnessvalley.in/costmanager
MILESWEB_UPLOAD_URL=https://wellnessvalley.in/costmanager/upload.php
MILESWEB_UPLOAD_SECRET=

# Optional: override API base for Capacitor / remote hosts
# VITE_API_BASE_URL=

# AI Token Monitor (optional)
VITE_AI_TOKEN_MONITOR_SDK_KEY=
VITE_AI_TOKEN_MONITOR_APP_NAME=Quote Buddy
VITE_AI_TOKEN_MONITOR_BASE_URL=https://e2w-ai-token-monitor.com/api

# Baleen Media (server-only)
QUOTE_BUDDY_API_KEY=
BALEEN_MEDIA_URL=

# SMTP (quote email + password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
INTERNAL_QUOTE_EMAIL_1=
INTERNAL_QUOTE_CC_EMAIL=
