# =============================================================================
# Quote Buddy — shared env (Vite + Express today; Next.js Phase 0+)
# Copy to .env and fill values. Do not commit .env.
# =============================================================================

# --- Client (Vite; later Next public) ---
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_MAX_FILE_SIZE_MB=10

# Optional: override API base for Capacitor / remote hosts
# VITE_API_BASE_URL=

# Phase 5 local cutover (Vite proxy). Default in vite.config.ts is Next :3000.
# Rollback to Express: VITE_DEV_API_PROXY=http://localhost:8787
# VITE_DEV_API_PROXY=http://localhost:3000
# Local /uploads disk fallback stays on Express unless overridden:
# VITE_DEV_UPLOADS_PROXY=http://localhost:8787


# --- MilesWeb MySQL (Prisma — source of truth) ---
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# --- Auth / sessions (Phase 1 will use these on Next routes) ---
AUTH_SECRET=change-me
AUTH_SESSION_SECRET=change-me
# Optional override for password-reset HMAC (falls back to AUTH_SECRET)
# PASSWORD_RESET_TOKEN_SECRET=

# --- Express API (current product runtime; keep until cutover) ---
API_PORT=8787
# Local disk fallback only when MilesWeb upload bridge is unset
# UPLOAD_ROOT=/home/USER/public_html/uploads

# --- Shared Cost Manager MilesWeb public storage (Vercel Production/Preview) ---
# Prefer RMS public base in prod, e.g. https://rms.baleenmedia.com
NEXT_PUBLIC_UPLOADS_BASE_URL=https://rms.baleenmedia.com
MILESWEB_UPLOAD_URL=https://baleenmedia.in/costmanager/upload.php
MILESWEB_UPLOAD_SECRET=

# --- AI Token Monitor (optional) ---
VITE_AI_TOKEN_MONITOR_SDK_KEY=
VITE_AI_TOKEN_MONITOR_APP_NAME=Quote Buddy
VITE_AI_TOKEN_MONITOR_BASE_URL=https://e2w-ai-token-monitor.com/api

# --- Baleen Media (server-only / Next Route Handlers) ---
QUOTE_BUDDY_API_KEY=
# Origin only — no trailing slash, no /.app
BALEEN_MEDIA_URL=

# --- SMTP (quote email + password reset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
INTERNAL_QUOTE_EMAIL_1=
INTERNAL_QUOTE_CC_EMAIL=
# INTERNAL_QUOTE_EMAIL_2=
# INTERNAL_QUOTE_EMAIL_3=
