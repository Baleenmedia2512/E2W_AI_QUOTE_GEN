VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_MAX_FILE_SIZE_MB=10

# Get your Gemini API key from: https://makersuite.google.com/app/apikey

# Supabase Configuration (for authentication)
# Get these from your Supabase Dashboard -> Settings -> API
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# AI Token Monitor (cloud telemetry — optional; leave blank to disable)
VITE_AI_TOKEN_MONITOR_SDK_KEY=
VITE_AI_TOKEN_MONITOR_APP_NAME=Quote Buddy
VITE_AI_TOKEN_MONITOR_BASE_URL=https://e2w-ai-token-monitor.com/api

